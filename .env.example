# Example only. Not a secret.
# The API reads PORT from the process environment. It does not load this file.
# When PORT is unset, the server listens on 8080.
PORT=8080

# Placeholder only. Not a real database and not a secret.
# Nothing in the application loads this file. Migrations read DATABASE_URL
# from the process environment. Integration tests read TEST_DATABASE_URL.
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
