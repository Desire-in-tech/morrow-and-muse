# Example only. Not a secret.
# The API reads PORT from the process environment. It does not load this file.
# When PORT is unset, the server listens on 8080.
PORT=8080

# Placeholder only. Not a real database and not a secret.
# Nothing in the application loads this file. The API and migrations read
# DATABASE_URL from the process environment. Integration tests read TEST_DATABASE_URL.
# The API exits if DATABASE_URL is unset. Do not put a live password here.
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require

# Placeholder only. Comma-separated browser origins. No wildcard and no credentials.
# Local Vite is http://localhost:5173. There is no production origin in this file.
CORS_ALLOWED_ORIGINS=http://localhost:5173
